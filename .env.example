# MySQL DSN (формат SQLAlchemy + asyncmy)
# Локальный Docker:
#   mysql+asyncmy://lenta:lenta@127.0.0.1:3306/lenta
# Yandex Cloud (родной FQDN, hostname валиден в сертификате):
#   mysql+asyncmy://user:pass@rc1a-xxxx.mdb.yandexcloud.net:3306/db?ssl_ca=/Users/USER/.mysql/root.crt
# Yandex Cloud через свой CNAME (cert не валиден для этого имени, отключаем hostname-check).
#   (БД общая с edalle backend — recepter, таблицы с префиксом shop_)
#   mysql+asyncmy://user:pass@public.mysql.gistrec.cloud:3306/recepter?ssl_ca=/Users/USER/.mysql/root.crt&ssl_check_hostname=false
MYSQL_DSN=mysql+asyncmy://lenta:lenta@127.0.0.1:3306/lenta

# Лента: поддомен города (см. ngsw.json: moscow, nsk, ekb, kzn, …)
CITY_SUBDOMAIN=moscow

# Заполняется по результатам recon (X-Domain, режим доставки, store_id и пр.)
# Пример (Москва, самовывоз): см. recon/endpoints.json
DELIVERY_MODE=pickup

# Параллелизм
CONCURRENCY=8
RPS=5

# Идентификатор устройства (любой UUID, фиксированный для стабильности сессии)
# Сгенерировать новый:  python -c "import uuid; print(uuid.uuid4())"
DEVICE_ID=a5429dbc-5b2e-42fe-8460-38871c9bcc69

# Кастомный User-Agent (пусто = десктопный Chrome 120).
# UA сам по себе Qrator/Лентой почти не учитывается — IP важнее. Меняй, только
# если хочешь имитировать конкретный браузер целиком, синхронно с Playwright.
USER_AGENT=

# Прокси для запросов к магазинам. Лента (Qrator) банит IP дата-центров и зарубежные —
# для неё нужен российский резидентный/мобильный прокси. Магниту прокси не нужен.
# Через прокси идут И httpx-запросы, И headless-Chromium (qrator warm-up).
# Форматы:
#   socks5://127.0.0.1:1080         — рекомендуемо: SSH-туннель `ssh -D 1080 -N user@vm-ip`
#   http://<vm-ip>:8888             — tinyproxy/3proxy на VM
#   http://user:pass@host:port      — HTTP-прокси с авторизацией
# Пусто = без прокси.
PROXY_URL=

# Логи
LOG_LEVEL=INFO

# Алерты в Telegram (блокировка/ошибка прогона, устаревшие данные). Пусто — только в лог.
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
