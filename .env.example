# MySQL DSN (формат SQLAlchemy + asyncmy)
# Локальный Docker:  mysql+asyncmy://lenta:lenta@127.0.0.1:3306/lenta
# Yandex Cloud:      mysql+asyncmy://user:password@rc1a-xxxxxxxxxxxxxxxx.mdb.yandexcloud.net:3306/lenta?ssl_ca=/home/USER/.mysql/root.crt
MYSQL_DSN=mysql+asyncmy://lenta:lenta@127.0.0.1:3306/lenta

# Поддомен города (см. ngsw.json: moscow, nsk, ekb, kzn, …)
CITY_SUBDOMAIN=moscow

# Заполняется по результатам recon (X-Domain, режим доставки, store_id и пр.)
# Пример (Москва, самовывоз): см. recon/endpoints.json
DELIVERY_MODE=pickup

# Параллелизм
CONCURRENCY=8
RPS=5

# Идентификатор устройства (любой UUID, фиксированный)
DEVICE_ID=11111111-1111-1111-1111-111111111111

# Логи
LOG_LEVEL=INFO
